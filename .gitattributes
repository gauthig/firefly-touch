# Normalize everything to LF inside the repository, regardless of each
# developer's core.autocrlf setting. Without this, line endings depend on the
# machine that made the commit and produce phantom whole-file diffs.
* text=auto eol=lf

# Windows-only scripts must keep CRLF in the working tree.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must be LF or they fail on Linux with "bad interpreter".
*.sh text eol=lf

# Generated by the IDF component manager — pin it so it stops flip-flopping.
dependencies.lock text eol=lf

# Binary assets: never convert, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.ico binary
*.pdf binary
*.bin binary
*.elf binary
*.zip binary

# GitHub language detection: .h here is C, not C++.
*.h linguist-language=C
docs/** linguist-documentation
