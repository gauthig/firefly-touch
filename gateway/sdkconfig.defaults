# firefly-gateway — Waveshare ESP32-S3-RS485-CAN (S3R8: 8 MB embedded octal PSRAM, 16 MB flash)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# The only USB port is the native USB-Serial/JTAG: make it the primary console so
# both logs and (later) commands use it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM (embedded, octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Bluetooth: Bluedroid, BLE only, GATT client only.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n
# ble_host's scan arbiter uses the legacy 4.2 GAP scan API, which is not linked
# when BLE 5.0 features are on (same fix as panels/sdkconfig.hvac_panel.defaults).
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
# Six devices (3 packs, Watchdog, solar, thermostat) plus scanning. Host and
# controller limits must agree -- the classic proxy's lesson, where only the host
# value was raised and the 4th link failed. S3 controller symbol is MAX_ACT.
CONFIG_BT_ACL_CONNECTIONS=7
CONFIG_BT_CTRL_BLE_MAX_ACT=8
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y

CONFIG_TWAI_ISR_IN_IRAM=y
