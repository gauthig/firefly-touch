# Bluedroid BLE-only, same as proxy/sdkconfig.defaults -- this tool has no
# WiFi/ESP-NOW need at all, just the BT stack for one GATT client.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=n

# ⚠️ ESP32-S3 defaults to CONFIG_BT_BLE_50_FEATURES_SUPPORTED, whose scan is
# the extended-scan API (esp_ble_gap_set_ext_scan_params/start/stop). This
# project is the FIRST thing to link components/ble_host on an S3 --
# jbd_bms/hughes_watchdog/renogy_solar all only ever ran on the proxy's
# classic ESP32 -- and ble_host.c's scan_ensure()/scan_on_adv() call the
# plain (4.2) esp_ble_gap_set_scan_params/start_scanning/stop_scanning,
# which are simply not linked in under BLE_50_FEATURES_SUPPORTED: link
# fails with "undefined reference". Force the 4.2 API here so the existing
# ble_host scan code works unmodified; the connect-side code in every
# client (including this one) already branches on this same symbol for
# esp_ble_gattc_open() vs _enh_open(), so this is consistent with what they
# expect on the "else" path. If a real hvac/ gateway later needs BLE 5.0
# extended advertising, ble_host's scan implementation needs an
# ext-scan-aware branch first -- that is shared-component work, out of
# scope for this bench tool.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n

# esp_timer for the poll interval must run from a task, not just the ISR
# dispatch method, since the callback calls into GATTC APIs.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
