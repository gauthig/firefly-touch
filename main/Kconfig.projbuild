menu "Firefly Touch Panel"

    config FIREFLY_SNIFFER_MODE
        bool "RV-C sniffer mode (log every received frame)"
        default n
        help
            Log every frame received on the RV-C bus to the serial monitor:
            raw 29-bit ID, decoded DGN, source address, and all 8 data bytes
            in hex. Use this on the bench to verify the instance map and to
            capture the factory PANEL LIGHTS (PL1) frames. Very chatty on a
            live coach bus — disable for production builds.

    menu "ESP-NOW remote-panel link"

        config FIREFLY_ESPNOW_PEER_MAC
            string "ESP-NOW peer MAC address (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                MAC address of this panel's ESP-NOW counterpart. For the
                mid_coach bridge build, this is the remote panel's MAC;
                for a remote (PANEL_HAS_CAN=0) panel build, this is
                mid_coach's MAC. Read a board's factory MAC with
                `idf.py -p COMx read-mac` before flashing either side. v1
                supports exactly one peer per panel.

        config FIREFLY_ESPNOW_CHANNEL
            int "ESP-NOW WiFi channel"
            default 1
            range 1 13
            help
                Both peers must be fixed to the same channel — there is no
                AP to negotiate one. Pick a channel clear of other 2.4 GHz
                traffic in the coach.

        config FIREFLY_ESPNOW_PMK
            string "ESP-NOW primary master key (16 ASCII chars)"
            default "firefly-pmk-0001"
            help
                esp_now_set_pmk() key, shared by both peers. CHANGE THIS
                before deploying — these frames actuate real loads.
                Truncated/zero-padded to 16 bytes if not exactly 16 chars.

        config FIREFLY_ESPNOW_LMK
            string "ESP-NOW peer local master key (16 ASCII chars)"
            default "firefly-lmk-0001"
            help
                Per-peer encryption key for esp_now_add_peer(). Must match
                on both sides of the pair. CHANGE THIS before deploying.

    endmenu

    menu "JBD-BMS battery monitor"

        config FIREFLY_BATTERY_1_MAC
            string "Battery 1 BLE MAC address (AA:BB:CC:DD:EE:FF)"
            default "00:00:00:00:00:00"
            help
                BLE MAC of the first Xiaoxiang/JBD BMS. The placeholder
                all-zero address means "unconfigured" -- that slot is
                skipped entirely (no connection attempted, status always
                reads as invalid) until a real MAC is set.

        config FIREFLY_BATTERY_2_MAC
            string "Battery 2 BLE MAC address (AA:BB:CC:DD:EE:FF)"
            default "00:00:00:00:00:00"
            help
                Same as FIREFLY_BATTERY_1_MAC, for the second battery.

        config FIREFLY_BATTERY_3_MAC
            string "Battery 3 BLE MAC address (AA:BB:CC:DD:EE:FF)"
            default "00:00:00:00:00:00"
            help
                Same as FIREFLY_BATTERY_1_MAC, for the third battery.

        config FIREFLY_BATTERY_POLL_INTERVAL_MS
            int "Battery status poll interval (ms)"
            default 30000
            range 20000 600000
            help
                How often each connected battery is asked for a fresh
                basic-info reading. SOC, current and time-remaining are all
                slow-moving values, so there is nothing to gain from polling
                hard.

                The 20 s lower bound is deliberate, not arbitrary: JBD BMS
                units are widely reported to misbehave when polled more
                often than roughly every 20 seconds, so the floor is
                enforced here rather than merely documented. The 30 s
                default leaves margin over that threshold.

                Note jbd_bms_client.c derives its "battery is healthy"
                staleness window from this value (3x), so raising the
                interval automatically widens the window instead of making
                every pack look permanently offline.

    endmenu

endmenu
