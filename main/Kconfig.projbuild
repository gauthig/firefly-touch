menu "Firefly Touch Panel"

    config FIREFLY_SNIFFER_MODE
        bool "RV-C sniffer mode (log every received frame)"
        default n
        help
            Log every frame received on the RV-C bus to the serial monitor:
            raw 29-bit ID, decoded DGN, source address, and all 8 data bytes
            in hex. Use this on the bench to verify the instance map and to
            capture the factory PANEL LIGHTS (PL1) frames. Very chatty on a
            live coach bus — disable for production builds.

    menu "ESP-NOW remote-panel link"

        config FIREFLY_ESPNOW_PEER_MAC
            string "ESP-NOW peer MAC address (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                MAC address of this panel's ESP-NOW counterpart. For the
                mid_coach bridge build, this is the remote panel's MAC;
                for a remote (PANEL_HAS_CAN=0) panel build, this is
                mid_coach's MAC. Read a board's factory MAC with
                `idf.py -p COMx read-mac` before flashing either side. v1
                supports exactly one peer per panel.

        config FIREFLY_ESPNOW_HVAC_PEER_MAC
            string "ESP-NOW thermostat-bridge peer MAC (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                MAC of the panel that holds the EasyTouch BLE link
                (hvac_panel). A panel with PANEL_WANTS_HVAC_CONTROL sends its
                mode/setpoint changes here as encrypted unicast. Leave at the
                placeholder on hvac_panel itself and on panels with no
                thermostat screen.

        config FIREFLY_ESPNOW_RX_PEER_MAC_1
            string "ESP-NOW extra receive peer 1 MAC (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                An extra node to accept encrypted unicast FROM. hvac_panel
                serves several panels' thermostat commands, so it lists each
                of them here (bedroom_remote, main_cabinet). Not a send
                target -- only a decrypt permission. Placeholder = unused.

        config FIREFLY_ESPNOW_RX_PEER_MAC_2
            string "ESP-NOW extra receive peer 2 MAC (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                Second extra receive peer -- see RX_PEER_MAC_1.

        config FIREFLY_ESPNOW_CHANNEL
            int "ESP-NOW WiFi channel"
            default 1
            range 1 13
            help
                Both peers must be fixed to the same channel — there is no
                AP to negotiate one. Pick a channel clear of other 2.4 GHz
                traffic in the coach.

        config FIREFLY_ESPNOW_PMK
            string "ESP-NOW primary master key (16 ASCII chars)"
            default "firefly-pmk-0001"
            help
                esp_now_set_pmk() key, shared by both peers. CHANGE THIS
                before deploying — these frames actuate real loads.
                Truncated/zero-padded to 16 bytes if not exactly 16 chars.

        config FIREFLY_ESPNOW_LMK
            string "ESP-NOW peer local master key (16 ASCII chars)"
            default "firefly-lmk-0001"
            help
                Per-peer encryption key for esp_now_add_peer(). Must match
                on both sides of the pair. CHANGE THIS before deploying.

    endmenu

    menu "JBD-BMS battery monitor"

        comment "A panel no longer connects to the batteries -- see proxy/"

        config FIREFLY_BATTERY_1_MAC
            string "Battery 1 BLE MAC address (display label only)"
            default "00:00:00:00:00:00"
            help
                BLE MAC of the first Xiaoxiang/JBD BMS.

                On a PANEL this is a display label and nothing more: it
                names a row in the battery bank's per-pack detail popup so a
                physical pack can be identified during troubleshooting. The
                BLE links themselves are held by the basement proxy
                (proxy/), which broadcasts the readings over ESP-NOW.

                Set it to the same MAC the proxy uses for slot 1. Left at
                the all-zero placeholder, the row simply shows "--" and
                still displays whatever telemetry arrives for that slot.

        config FIREFLY_BATTERY_2_MAC
            string "Battery 2 BLE MAC address (AA:BB:CC:DD:EE:FF)"
            default "00:00:00:00:00:00"
            help
                Same as FIREFLY_BATTERY_1_MAC, for the second battery.

        config FIREFLY_BATTERY_3_MAC
            string "Battery 3 BLE MAC address (AA:BB:CC:DD:EE:FF)"
            default "00:00:00:00:00:00"
            help
                Same as FIREFLY_BATTERY_1_MAC, for the third battery.

        config FIREFLY_SOLAR_BROADCAST_INTERVAL_MS
        int "Solar telemetry broadcast interval (ms)"
        default 30000
        range 5000 600000
        help
            How often the basement proxy re-broadcasts the Renogy MPPT
            reading. A panel does not poll the controller -- it has no BLE
            link to it -- so this is not a poll interval here. It exists
            only so the panel can DERIVE how long silence must last before
            the readout ages out to "--" (3x this value).

            Keep it in step with the proxy's FIREFLY_SOLAR_POLL_INTERVAL_MS.
            Setting it shorter than the proxy's actual interval makes the
            solar readout flicker to "--" between broadcasts -- the same
            failure the battery packs hit when their staleness window was
            hardcoded shorter than their poll interval.

    config FIREFLY_BATTERY_POLL_INTERVAL_MS
            int "Battery status poll interval (ms)"
            default 30000
            range 20000 600000
            help
                How often each connected battery is asked for a fresh
                basic-info reading -- and, on a panel, how often the proxy
                is expected to re-broadcast one. SOC, current and
                time-remaining are all slow-moving values, so there is
                nothing to gain from polling hard.

                Keep this in step with the proxy's own setting: a panel
                derives its "pack has gone quiet" window from this value
                (3x), so a panel configured far below the proxy's real
                interval would show packs flickering offline between
                broadcasts.

                The 20 s lower bound is deliberate, not arbitrary: JBD BMS
                units are widely reported to misbehave when polled more
                often than roughly every 20 seconds, so the floor is
                enforced here rather than merely documented. The 30 s
                default leaves margin over that threshold.

                Note jbd_bms_client.c derives its "battery is healthy"
                staleness window from this value (3x), so raising the
                interval automatically widens the window instead of making
                every pack look permanently offline.

    endmenu

    menu "EasyTouch RV thermostat"

        comment "Only the hvac_panel build uses these (PANEL_HAS_EASYTOUCH)"

        config FIREFLY_EASYTOUCH_PASSWORD
            string "Micro-Air account password"
            default ""
            help
                Password of the Micro-Air account already paired to the
                coach's EasyTouch thermostat -- the same one the phone app
                uses over Bluetooth. This is the ONLY credential the protocol
                uses; there is no separate BLE pairing (see
                docs/EASYTOUCH-THERMOSTAT.md section 2).

                Set this in the per-build-dir sdkconfig only
                (build_hvac_panel/sdkconfig) -- NEVER in sdkconfig.defaults,
                same handling as the ESP-NOW keys and battery MACs above.
                Empty = the client logs and idles.

        config FIREFLY_EASYTOUCH_EMAIL
            string "Micro-Air account e-mail (optional)"
            default ""
            help
                Only consulted by the hvac_capture bench tool's A/B test. The
                production client (easytouch_client.c) never sends EM or TM:
                the panel has no clock, and a bogus TM would set the
                thermostat's schedule clock. Leave blank.

        config FIREFLY_EASYTOUCH_NAME_PREFIX
            string "Advertised name prefix to scan for"
            default "EasyTouch"
            help
                The thermostat advertises as "EasyTouch <serial>". Prefix
                match is enough for one thermostat in range; the client pins
                the MAC after the first hit.

        config FIREFLY_EASYTOUCH_POLL_INTERVAL_MS
            int "Status poll interval (ms)"
            default 30000
            range 20000 60000
            help
                How often the client connects, reads status, and
                disconnects. It does NOT hold the link between polls, so the
                phone app stays usable (docs/EASYTOUCH-THERMOSTAT.md section
                6). easytouch_client.c derives its staleness window from this
                (3x), so raising it widens the window rather than making the
                readout flicker to "--".

        config FIREFLY_EASYTOUCH_ZONE0_NAME
            string "Zone 0 label"
            default "FRONT"
            help
                On-screen name for Z_sts zone 0. This coach's 355 orders the
                zones Front / Mid Coach / Rear (docs/EASYTOUCH-THERMOSTAT.md
                section 8a).

        config FIREFLY_EASYTOUCH_ZONE1_NAME
            string "Zone 1 label"
            default "MID COACH"

        config FIREFLY_EASYTOUCH_ZONE2_NAME
            string "Zone 2 label"
            default "REAR"

        config FIREFLY_HVAC_BROADCAST_INTERVAL_MS
            int "HVAC telemetry broadcast interval (ms)"
            default 30000
            range 5000 120000
            help
                How often hvac_panel re-broadcasts each thermostat zone over
                ESP-NOW (one frame per present zone). A viewing panel derives
                its "reading has gone stale" window from this (3x), the same
                way it does for battery / shore / solar. Keep it near the BLE
                poll interval -- there is nothing fresher to send between
                polls anyway.

    endmenu

endmenu
