menu "Firefly Touch Panel"

    config FIREFLY_SNIFFER_MODE
        bool "RV-C sniffer mode (log every received frame)"
        default n
        help
            Log every frame received on the RV-C bus to the serial monitor:
            raw 29-bit ID, decoded DGN, source address, and all 8 data bytes
            in hex. Use this on the bench to verify the instance map and to
            capture the factory PANEL LIGHTS (PL1) frames. Very chatty on a
            live coach bus — disable for production builds.

    menu "ESP-NOW remote-panel link"

        config FIREFLY_ESPNOW_PEER_MAC
            string "ESP-NOW peer MAC address (AA:BB:CC:DD:EE:FF)"
            default "AA:BB:CC:DD:EE:FF"
            help
                MAC address of this panel's ESP-NOW counterpart. For the
                living_room bridge build, this is the remote panel's MAC;
                for a remote (PANEL_HAS_CAN=0) panel build, this is
                living_room's MAC. Read a board's factory MAC with
                `idf.py -p COMx read-mac` before flashing either side. v1
                supports exactly one peer per panel.

        config FIREFLY_ESPNOW_CHANNEL
            int "ESP-NOW WiFi channel"
            default 1
            range 1 13
            help
                Both peers must be fixed to the same channel — there is no
                AP to negotiate one. Pick a channel clear of other 2.4 GHz
                traffic in the coach.

        config FIREFLY_ESPNOW_PMK
            string "ESP-NOW primary master key (16 ASCII chars)"
            default "firefly-pmk-0001"
            help
                esp_now_set_pmk() key, shared by both peers. CHANGE THIS
                before deploying — these frames actuate real loads.
                Truncated/zero-padded to 16 bytes if not exactly 16 chars.

        config FIREFLY_ESPNOW_LMK
            string "ESP-NOW peer local master key (16 ASCII chars)"
            default "firefly-lmk-0001"
            help
                Per-peer encryption key for esp_now_add_peer(). Must match
                on both sides of the pair. CHANGE THIS before deploying.

    endmenu

    menu "Wi-Fi OTA update"

        config FIREFLY_OTA_WIFI_SSID
            string "OTA WiFi SSID"
            default ""
            help
                SSID of the WiFi network to join when checking for or
                downloading an OTA update. Only used while an update check
                is running — the panel is off this network the rest of the
                time (ESP-NOW does not need it).

        config FIREFLY_OTA_WIFI_PASSWORD
            string "OTA WiFi password"
            default ""
            help
                WPA2 password for FIREFLY_OTA_WIFI_SSID. Stored in plain
                text in sdkconfig — do not commit a real password (this
                repo's sdkconfig is gitignored).

        config FIREFLY_OTA_MANIFEST_URL
            string "OTA manifest URL"
            default "https://example.invalid/firefly-touch/living_room_remote/manifest.json"
            help
                HTTPS URL of the JSON manifest ({"version":"x.y.z",
                "url":"..."}) describing the latest available firmware.
                The url field must also be HTTPS — esp_https_ota()
                validates the server certificate against the ESP-IDF
                certificate bundle (CONFIG_MBEDTLS_CERTIFICATE_BUNDLE).

        config FIREFLY_OTA_CONNECT_TIMEOUT_MS
            int "OTA WiFi connect / HTTP timeout (ms)"
            default 15000
            range 1000 120000
            help
                Applies to both the WiFi STA connect wait and each HTTP(S)
                request (manifest fetch, firmware download). A panel that
                can't reach the update server gives up and returns to
                normal operation instead of hanging.

        config FIREFLY_OTA_CHECK_ON_BOOT
            bool "Check for OTA update automatically on every boot"
            default n
            help
                Off by default: OTA checks are triggered manually (see
                ota_update_request_check(), wired to a UI action in
                GitHub issue #17) so a panel never joins WiFi / drops its
                ESP-NOW link without being asked to. Enable only if you
                have a reliable always-on OTA WiFi network in the coach.

    endmenu

endmenu
